<view class="tab-bar">
  <block wx:for="{{list}}" wx:key="pagePath">
    <view
      wx:if="{{index < 2 || isAdmin}}"
      class="tab-bar-item {{selected === index ? 'selected' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon">{{item.icon}}</view>
      <view class="tab-text">{{item.text}}</view>
    </view>
  </block>
</view>
