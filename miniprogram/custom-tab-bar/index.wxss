.tab-bar { position: fixed; z-index: 100; right: 0; bottom: 0; left: 0; height: 116rpx; padding-bottom: env(safe-area-inset-bottom); background: rgba(255,255,255,.96); display: flex; border-top: 1rpx solid #edf0f6; }
.tab-bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9aa3b2; font-size: 22rpx; gap: 7rpx; }
.tab-bar-item.selected { color: #4d6bfe; font-weight: 600; }
.tab-icon { font-size: 38rpx; line-height: 38rpx; }
