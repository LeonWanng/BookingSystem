<view class="page">
  <view class="admin-head">
    <view class="title">机构管理</view>
    <view class="muted">课程、人员与服务数据</view>
  </view>

  <view class="demo-role card">
    <view>
      <view class="role-label">演示当前角色</view>
      <view class="muted">切换后返回工作台即可按该身份讲解</view>
    </view>
    <picker mode="selector" range="{{roleOptions}}" value="{{roleIndex}}" bindchange="changeRole">
      <view class="role-picker">{{currentRole}} <text>⌄</text></view>
    </picker>
  </view>

  <view class="tabs" wx:if="{{currentRole === '管理员'}}">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >{{item.name}}</view>
  </view>

  <block wx:if="{{currentRole === '家长'}}">
    <view class="role-note card">
      <view class="role-title">家长端暂不开放机构管理</view>
      <view class="muted">请从“我的预约”查看自己的试听安排和进度。</view>
    </view>
  </block>

  <block wx:elif="{{currentRole === '管理员' && activeTab === 'course'}}">
    <view class="hint">课程管理</view>
    <view class="card course" wx:for="{{courses}}" wx:key="name">
      <view class="course-icon">{{item.icon}}</view>
      <view class="grow">
        <view class="course-name">{{item.name}}</view>
        <view class="muted">{{item.duration}} · {{item.teacher}}</view>
      </view>
      <view>
        <view class="tag green">上架中</view>
        <view class="slots">{{item.slots}} 个可约时段</view>
      </view>
    </view>
    <button class="add-btn" bindtap="toggleCourseForm">{{showCourseForm ? '收起' : '＋ 添加课程'}}</button>
    <view class="add-form card" wx:if="{{showCourseForm}}">
      <view class="form-title">新增课程</view>
      <input class="form-input" placeholder="课程名称" data-field="name" value="{{courseForm.name}}" bindinput="courseInput" />
      <view class="form-row">
        <input class="form-input form-half" type="number" placeholder="时长（分钟）" data-field="duration" value="{{courseForm.duration}}" bindinput="courseInput" />
        <input class="form-input form-half" type="number" placeholder="可约时段数" data-field="slots" value="{{courseForm.slots}}" bindinput="courseInput" />
      </view>
      <input class="form-input" placeholder="授课老师" data-field="teacher" value="{{courseForm.teacher}}" bindinput="courseInput" />
      <button class="primary-btn form-submit" bindtap="submitCourse">保存课程</button>
    </view>

    <view class="hint">可预约时间段</view>
    <view class="schedule card" wx:for="{{schedules}}" wx:key="id">
      <view class="date-badge">
        <view>{{item.week}}</view>
        <view>{{item.date}}</view>
      </view>
      <view class="grow">
        <view>{{item.time}}</view>
        <view class="muted">{{item.course}} · {{item.teacher}}</view>
      </view>
      <view class="tag blue">余 {{item.remaining}}</view>
    </view>
  </block>

  <block wx:elif="{{currentRole === '管理员' && activeTab === 'review'}}">
    <view class="review card" wx:for="{{reviews}}" wx:key="name">
      <view class="review-head">
        <view class="review-avatar">{{item.avatar}}</view>
        <view class="grow">
          <view>{{item.name}} <text class="muted">· {{item.course}}</text></view>
          <view class="stars">★★★★★</view>
        </view>
      </view>
      <view class="review-text">{{item.content}}</view>
      <view class="muted">{{item.date}} · {{item.status}}</view>
    </view>
  </block>

  <block wx:elif="{{currentRole === '管理员'}}">
    <view class="role-note card">
      <view class="role-title">当前身份：{{currentRole}}</view>
      <view class="muted">不同岗位仅可访问职责范围内的数据和操作。</view>
    </view>
    <view class="staff card" wx:for="{{staffs}}" wx:key="name">
      <view class="staff-avatar">{{item.avatar}}</view>
      <view class="grow">
        <view class="staff-name">{{item.name}} <text class="tag blue">{{item.role}}</text></view>
        <view class="muted">{{item.phone}} · {{item.skills}}</view>
      </view>
      <switch checked="{{item.enabled}}" color="#4d6bfe" data-index="{{index}}" bindchange="toggleStaff" />
    </view>
    <button class="add-btn" bindtap="toggleStaffForm">{{showStaffForm ? '收起' : '＋ 添加员工'}}</button>
    <view class="add-form card" wx:if="{{showStaffForm}}">
      <view class="form-title">新增员工</view>
      <input class="form-input" placeholder="员工姓名" data-field="name" value="{{staffForm.name}}" bindinput="staffInput" />
      <picker class="form-picker" mode="selector" range="{{staffRoles}}" value="{{staffRoleIndex}}" bindchange="staffRoleChange">
        <view>{{staffForm.role}} <text>⌄</text></view>
      </picker>
      <input class="form-input" type="number" placeholder="手机号" data-field="phone" value="{{staffForm.phone}}" bindinput="staffInput" />
      <input class="form-input" placeholder="负责方向，例如：美术启蒙" data-field="skills" value="{{staffForm.skills}}" bindinput="staffInput" />
      <button class="primary-btn form-submit" bindtap="submitStaff">保存员工</button>
    </view>
    <view class="permission card">
      <view class="permission-title">角色权限</view>
      <view class="permission-row"><text>管理员</text><text>全部数据与系统设置</text></view>
      <view class="permission-row"><text>前台</text><text>预约确认、到店签到</text></view>
      <view class="permission-row"><text>老师</text><text>试听记录、个人课程表</text></view>
    </view>
  </block>

  <block wx:elif="{{currentRole === '前台'}}">
    <view class="role-note card">
      <view class="role-title">前台工作台</view>
      <view class="muted">只展示今日接待任务，不开放课程、评价和员工管理。</view>
    </view>
    <view class="hint">今日接待</view>
    <view class="front-item card" wx:for="{{frontAppointments}}" wx:key="id">
      <view class="front-time">{{item.time}}</view>
      <view class="grow"><view class="staff-name">{{item.student}}</view><view class="muted">{{item.course}} · {{item.teacher}}</view></view>
      <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
    </view>
    <button class="add-btn" bindtap="goBooking">进入预约与签到</button>
  </block>

  <block wx:elif="{{currentRole === '老师'}}">
    <view class="role-note card">
      <view class="role-title">老师工作台</view>
      <view class="muted">只展示分配给你的试听课，不开放机构汇总数据。</view>
    </view>
    <view class="hint">我的试听课</view>
    <view class="schedule card" wx:for="{{mySchedules}}" wx:key="id">
      <view class="date-badge"><view>{{item.week}}</view><view>{{item.date}}</view></view>
      <view class="grow"><view>{{item.time}}</view><view class="muted">{{item.course}}</view></view>
      <view class="tag blue">{{item.statusText}}</view>
    </view>
    <view class="hint">待填写试听记录</view>
    <view class="front-item card" wx:for="{{teacherTrials}}" wx:key="id">
      <view class="grow"><view class="staff-name">{{item.student}}</view><view class="muted">{{item.course}} · {{item.time}}</view></view>
      <button class="ghost-btn" data-id="{{item.id}}" bindtap="writeTrial">填写记录</button>
    </view>
  </block>

</view>
