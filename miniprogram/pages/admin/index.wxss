.admin-head { margin:8rpx 0 28rpx; }.title {font-size:44rpx;font-weight:700;margin-bottom:10rpx}.tabs { display:flex; background:#ebeff8; border-radius:14rpx; padding:6rpx; margin-bottom:28rpx; }.tab { flex:1; text-align:center; padding:16rpx 0; font-size:25rpx; color:#7c8799; border-radius:10rpx; }.tab.active { color:#4d6bfe; background:#fff; font-weight:700; box-shadow:0 3rpx 10rpx rgba(40,55,85,.08); }.hint { font-weight:700; font-size:29rpx; margin:28rpx 0 16rpx; }.course,.schedule,.staff,.review { display:flex; align-items:center; margin-bottom:16rpx; }.course-icon { width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;background:#eef1ff;color:#4d6bfe;border-radius:16rpx;font-size:33rpx;margin-right:18rpx; }.grow {flex:1}.course-name,.staff-name {font-size:29rpx;font-weight:700;margin-bottom:9rpx}.slots {font-size:21rpx;color:#8892a4;margin-top:10rpx;text-align:right}.add-btn { width:100%; border:2rpx dashed #b8c4ff; background:#f5f7ff; color:#4d6bfe; border-radius:16rpx; font-size:26rpx; margin:6rpx 0 8rpx; }.date-badge {width:66rpx;height:66rpx;border-radius:14rpx;background:#fff2df;color:#d98525;text-align:center;padding-top:8rpx;font-size:21rpx;margin-right:18rpx}.date-badge view:last-child{font-size:25rpx;font-weight:700;margin-top:2rpx}.role-note { background:#eef1ff; margin-bottom:20rpx }.role-title,.permission-title{font-size:29rpx;font-weight:700;margin-bottom:10rpx}.staff-avatar,.review-avatar{width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e8f8f0;color:#20a36a;font-size:29rpx;font-weight:700;margin-right:16rpx}.permission {margin-top:28rpx}.permission-row{display:flex;justify-content:space-between;border-top:1rpx solid #edf0f6;padding:20rpx 0;font-size:24rpx}.permission-row text:last-child{color:#8892a4}.review {display:block}.review-head{display:flex;align-items:center}.stars{color:#f4ae3b;letter-spacing:3rpx;font-size:23rpx}.review-text{font-size:26rpx;line-height:1.7;margin:22rpx 0;color:#3d4758}
.demo-role { display:flex; align-items:center; justify-content:space-between; margin-bottom:22rpx; padding:22rpx 26rpx; background:#f0f3ff; }.role-label { font-size:27rpx; font-weight:700; margin-bottom:7rpx; }.role-picker { min-width:150rpx; padding:15rpx 20rpx; border-radius:12rpx; background:#fff; color:#4d6bfe; font-size:26rpx; text-align:center; }.role-picker text { margin-left:10rpx; }
.front-item { display:flex; align-items:center; gap:18rpx; margin-bottom:16rpx; }.front-time { width:88rpx; color:#4d6bfe; font-size:28rpx; font-weight:700; }
.add-form { margin: 14rpx 0 24rpx; padding: 24rpx; }.form-title { font-size: 29rpx; font-weight: 700; margin-bottom: 18rpx; }.form-input,.form-picker { width: 100%; min-height: 76rpx; padding: 0 20rpx; margin-bottom: 16rpx; border: 1rpx solid #e4e8f2; border-radius: 12rpx; background: #fafbfe; color: #172033; font-size: 25rpx; line-height: 76rpx; }.form-row { display:flex; gap:16rpx; }.form-half { flex:1; }.form-picker { display:flex; align-items:center; justify-content:space-between; }.form-picker text { color:#8892a4; }.form-submit { width:100%; margin-top: 4rpx; }
