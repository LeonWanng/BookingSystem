<view class="page" wx:if="{{appointment}}">
  <view class="detail-head"><view><view class="title">{{appointment.student}}</view><view class="muted">{{appointment.phone}} · {{appointment.age}}岁</view></view><view class="tag {{appointment.statusClass}}">{{appointment.statusText}}</view></view>
  <view class="card detail-card"><view class="detail-row"><text class="label">试听课程</text><text>{{appointment.course}}</text></view><view class="detail-row"><text class="label">到店时间</text><text>{{appointment.date}} {{appointment.time}}</text></view><view class="detail-row"><text class="label">接待老师</text><text>{{appointment.teacher}}</text></view></view>
  <view class="card timeline"><view class="detail-title">预约进度</view><view class="timeline-item done"><view class="dot">✓</view><view><view>提交预约</view><view class="muted">预约信息已提交</view></view></view><view class="timeline-item {{appointment.statusText !== '待确认' ? 'done' : ''}}"><view class="dot">{{appointment.statusText !== '待确认' ? '✓' : '2'}}</view><view><view>机构确认</view><view class="muted">{{appointment.statusText === '待确认' ? '等待机构确认' : '机构已确认预约'}}</view></view></view><view class="timeline-item {{appointment.statusText === '已到店' || appointment.statusText === '已完成' ? 'done' : ''}}"><view class="dot">3</view><view><view>到店试听</view><view class="muted">到店后由前台签到</view></view></view><view class="timeline-item {{appointment.statusText === '已完成' ? 'done' : ''}}"><view class="dot">4</view><view><view>课后评价</view><view class="muted">试听完成后可评价</view></view></view></view>
  <button class="primary-btn" bindtap="goBooking">返回预约列表</button>
</view>
