<view class="page">
  <view class="booking-head"><view><view class="title">{{currentRole === '家长' ? '我的预约' : '预约试听'}}</view><view class="muted">{{currentRole === '家长' ? '仅展示本人预约记录' : '共 ' + appointments.length + ' 条预约 · ' + (mode === 'checkin' ? '到店签到模式' : '本周安排')}}</view></view><button class="primary-btn" wx:if="{{currentRole !== '老师'}}" bindtap="toggleForm">{{showForm ? '收起' : '＋ 新预约'}}</button></view>
  <view class="filters" wx:if="{{currentRole !== '家长'}}"><view class="filter {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="chooseFilter">全部</view><view class="filter {{filter === 'waiting' ? 'active' : ''}}" data-filter="waiting" bindtap="chooseFilter">待确认 <text class="count">{{waitingCount}}</text></view><view class="filter {{filter === 'checked' ? 'active' : ''}}" data-filter="checked" bindtap="chooseFilter">已到店</view><view class="filter {{filter === 'finished' ? 'active' : ''}}" data-filter="finished" bindtap="chooseFilter">已完成</view></view>
  <view class="form card" wx:if="{{showForm}}">
    <view class="form-title">新建试听预约</view>
    <input class="input" placeholder="学员姓名" value="{{form.student}}" data-field="student" bindinput="inputChange" />
    <view class="row"><input class="input half" placeholder="年龄" type="number" value="{{form.age}}" data-field="age" bindinput="inputChange" /><input class="input half" placeholder="家长手机号" type="number" value="{{form.phone}}" data-field="phone" bindinput="inputChange" /></view>
    <picker class="picker" mode="selector" range="{{courses}}" bindchange="courseChange"><view>{{form.course || '选择试听课程'}} <text>⌄</text></view></picker>
    <picker class="picker" mode="time" bindchange="timeChange"><view>{{form.time || '选择到店时间'}} <text>⌄</text></view></picker>
    <button class="primary-btn submit" bindtap="submitBooking">确认预约</button>
  </view>
  <view class="booking-card card" wx:for="{{displayAppointments}}" wx:key="id">
    <view class="booking-top"><view><view class="student">{{item.student}} <text class="age">{{item.age}}岁</text></view><view class="muted">{{item.phone}}</view></view><view class="tag {{item.statusClass}}">{{item.statusText}}</view></view>
    <view class="booking-info"><view class="info-block"><view class="label">试听课程</view><view>{{item.course}}</view></view><view class="info-block"><view class="label">到店时间</view><view>{{item.date}} {{item.time}}</view></view></view>
    <view class="booking-foot"><view class="muted">接待：{{item.teacher}}</view><view><button class="ghost-btn" wx:if="{{(currentRole === '管理员' || currentRole === '前台') && item.statusText === '待确认'}}" data-id="{{item.id}}" bindtap="confirmBooking">确认预约</button><button class="ghost-btn" wx:if="{{(currentRole === '管理员' || currentRole === '前台') && item.statusText === '已确认'}}" data-id="{{item.id}}" bindtap="checkin">到店签到</button><button class="ghost-btn" wx:if="{{(currentRole === '管理员' || currentRole === '老师') && item.statusText === '已到店'}}" data-id="{{item.id}}" bindtap="finish">填写试听记录</button></view></view>
  </view>
</view>
