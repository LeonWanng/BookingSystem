.booking-head { display:flex; justify-content:space-between; align-items:center; margin: 8rpx 0 32rpx; }.title { font-size:44rpx; font-weight:700; margin-bottom:10rpx; }.booking-head .primary-btn { font-size:24rpx; line-height:64rpx; height:64rpx; padding:0 20rpx; }.filters { display:flex; gap:28rpx; margin-bottom:24rpx; color:#8993a4; font-size:25rpx; }.filter.active { color:#4d6bfe; font-weight:700; border-bottom:4rpx solid #4d6bfe; padding-bottom:12rpx; }.count { background:#fff0df; color:#d98525; font-size:19rpx; padding:3rpx 9rpx; border-radius:12rpx; }.form { margin-bottom:24rpx; }.form-title { font-size:30rpx; font-weight:700; margin-bottom:24rpx; }.input,.picker { height:76rpx; background:#f6f8fb; border-radius:12rpx; margin-bottom:18rpx; padding:0 22rpx; display:flex; align-items:center; font-size:26rpx; }.input { width:100%; }.row { display:flex; gap:18rpx; }.half { flex:1; width:auto; }.picker { justify-content:space-between; color:#697587; }.picker text { color:#4d6bfe; }.submit { margin-top:8rpx; }.booking-card { margin-bottom:18rpx; }.booking-top,.booking-foot { display:flex; justify-content:space-between; align-items:center; }.student { font-size:31rpx; font-weight:700; margin-bottom:8rpx; }.age { font-size:23rpx; color:#8892a4; font-weight:400; }.booking-info { display:flex; margin:26rpx 0; padding:22rpx 0; border-top:1rpx solid #edf0f6; border-bottom:1rpx solid #edf0f6; }.info-block { flex:1; font-size:25rpx; }.label { color:#99a2b1; font-size:22rpx; margin-bottom:8rpx; }.booking-foot { font-size:23rpx; }.booking-foot button { display:inline-block; margin-left:12rpx; }
