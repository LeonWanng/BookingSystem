.hero { display: flex; justify-content: space-between; align-items: center; margin: 8rpx 0 34rpx; }.eyebrow { font-size: 23rpx; color: #8892a4; margin-bottom: 12rpx; }.hello { font-size: 44rpx; font-weight: 700; margin-bottom: 10rpx; }.avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #dfe5ff; color: #4d6bfe; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 700; }.stats { display: flex; justify-content: space-between; padding: 30rpx 18rpx; }.stat { flex: 1; text-align: center; border-right: 1rpx solid #edf0f6; }.stat:last-child { border-right: 0; }.stat-num { font-size: 38rpx; font-weight: 700; margin-bottom: 8rpx; }.blue-text { color: #4d6bfe; }.orange-text { color: #e09a3e; }.green-text { color: #20a36a; }.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.quick { padding: 24rpx; }.quick-icon { width: 58rpx; height: 58rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-bottom: 18rpx; }.purple { color: #6654e8; background: #eeebff; }.green { color: #20a36a; background: #e8f8f0; }.orange { color: #d98525; background: #fff2df; }.blue { color: #4d6bfe; background: #e9edff; }.quick-name { font-weight: 700; font-size: 28rpx; margin-bottom: 8rpx; }.appointment-list { padding: 0 28rpx; }.appointment { min-height: 112rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0f6; gap: 18rpx; }.appointment:last-child { border-bottom: 0; }.time { width: 80rpx; color: #4d6bfe; font-size: 26rpx; font-weight: 700; }.appointment-main { flex: 1; }.name { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }.empty { text-align: center; color: #99a2b1; padding: 50rpx 0; }
